# Copy this file to ".env" and adjust values as needed.

# Base URL of your local Ollama server (default install uses this)
OLLAMA_BASE_URL=http://localhost:11434

# TODO: Replace with the exact model name you have pulled in Ollama.
# Check available models by running: ollama list
# Examples: llama3.1, mistral, qwen2.5, gemma2
OLLAMA_MODEL=REPLACE_WITH_YOUR_MODEL

# Optional: request timeout (seconds) for calls to Ollama
OLLAMA_TIMEOUT=120

# SQLite database file (relative to project root)
DATABASE_PATH=data/scores.db
